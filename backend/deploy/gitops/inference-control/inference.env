ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=api.arkya.online;arkya-inference;arkya-inference.arkya-beta.svc.cluster.local
Mongo__DatabaseName=arkya_inference
Inference__MaxWorkers=12
Inference__MaxThreadsPerWorker=24
Inference__MaxTotalThreads=96
Inference__HeartbeatSeconds=5
Inference__OfflineAfterSeconds=30
ProxyTrust__KnownNetworks__0=10.42.0.0/16
ProxyTrust__ForwardLimit=1
InternalHttp__AllowedNetworks__0=10.42.0.0/16
InternalHttp__AllowedNetworks__1=192.168.100.0/24
