ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=api.arkya.online;arkya-reports;arkya-reports.arkya-beta.svc.cluster.local
Mongo__DatabaseName=arkya_reports
Identity__BaseUrl=http://arkya-identity.arkya-beta.svc.cluster.local:8080/
Identity__AllowClusterHttp=true
WebClient__AllowedOrigins__0=https://arkya.online
ReportsAdmin__Actor=reports-admin
ProxyTrust__KnownNetworks__0=10.42.0.0/16
ProxyTrust__ForwardLimit=1
InternalHttp__AllowedNetworks__0=10.42.0.0/16
InternalHttp__AllowedNetworks__1=192.168.100.0/24
