ASPNETCORE_ENVIRONMENT=Production
DOTNET_EnableDiagnostics=0
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__System.Net.Http.HttpClient=Warning
AllowedHosts=arkya-content;arkya-content.arkya-operations.svc.cluster.local
Mongo__DatabaseName=arkya_content
Kestrel__Endpoints__Internal__Url=https://0.0.0.0:8443
Kestrel__Endpoints__Internal__Certificate__Path=/etc/arkya/tls/tls.crt
Kestrel__Endpoints__Internal__Certificate__KeyPath=/etc/arkya/tls/tls.key
