ASPNETCORE_ENVIRONMENT=Production
DOTNET_EnableDiagnostics=0
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__System.Net.Http.HttpClient=Warning
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=admin.arkya.online;arkya-admin;arkya-admin.arkya-operations.svc.cluster.local
DataProtection__KeysPath=/var/lib/arkya/keys
Mongo__DatabaseName=arkya_admin
AdminSessions__AccessLifetime=00:30:00
AdminSessions__RefreshLifetime=30.00:00:00
ProxyTrust__KnownNetworks__0=10.42.0.0/16
ProxyTrust__ForwardLimit=1
ContentApi__Enabled=true
ContentApi__BaseUrl=https://arkya-content.arkya-operations.svc.cluster.local:8443/
RealmsApi__Enabled=true
RealmsApi__BaseUrl=https://arkya-realms.arkya-operations.svc.cluster.local:8443/
SSL_CERT_FILE=/etc/arkya/internal-ca/ca.crt
