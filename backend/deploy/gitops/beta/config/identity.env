ASPNETCORE_ENVIRONMENT=Production
DOTNET_EnableDiagnostics=0
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__System.Net.Http.HttpClient=Warning
AllowedHosts=api.arkya.online;arkya-identity;arkya-identity.arkya-identity.svc.cluster.local
Mongo__DatabaseName=arkya_identity
Discord__PublicBaseUrl=https://api.arkya.online
Discord__RedirectUri=https://api.arkya.online/v1/auth/discord/callback
Sessions__Lifetime=08:00:00
WebClient__AllowedOrigins__0=https://arkya.online
WebClient__AllowedOrigins__1=https://arkya-atlas.easykrill33.chatgpt.site
ReverseProxy__KnownNetworks__0=10.42.0.0/16
ReverseProxy__ForwardLimit=1
Management__Port=8081
Management__ReadinessTimeout=00:00:02
DataProtection__KeysPath=/var/lib/arkya/keys
Kestrel__Endpoints__Public__Url=http://0.0.0.0:8080
Kestrel__Endpoints__Management__Url=http://0.0.0.0:8081
Kestrel__Endpoints__Internal__Url=https://0.0.0.0:8443
Kestrel__Endpoints__Internal__Certificate__Path=/etc/arkya/tls/tls.crt
Kestrel__Endpoints__Internal__Certificate__KeyPath=/etc/arkya/tls/tls.key
