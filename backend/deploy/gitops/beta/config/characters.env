ASPNETCORE_ENVIRONMENT=Production
DOTNET_EnableDiagnostics=0
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__System.Net.Http.HttpClient=Warning
AllowedHosts=api.arkya.online;arkya-characters;arkya-characters.arkya-identity.svc.cluster.local
Mongo__DatabaseName=arkya_characters
Identity__BaseUrl=https://arkya-identity.arkya-identity.svc.cluster.local:8443/
Realms__BaseUrl=https://arkya-realms.arkya-operations.svc.cluster.local:8443/
GameAccess__DedicatedServers__0__RealmId=beta-web
GameAccess__DedicatedServers__0__ServerId=island
WebClient__AllowedOrigins__0=https://arkya.online
WebClient__AllowedOrigins__1=https://arkya-atlas.easykrill33.chatgpt.site
ProxyTrust__KnownNetworks__0=10.42.0.0/16
ProxyTrust__ForwardLimit=1
Kestrel__Endpoints__Public__Url=http://0.0.0.0:8080
Kestrel__Endpoints__Internal__Url=https://0.0.0.0:8443
Kestrel__Endpoints__Internal__Certificate__Path=/etc/arkya/tls/tls.crt
Kestrel__Endpoints__Internal__Certificate__KeyPath=/etc/arkya/tls/tls.key
SSL_CERT_FILE=/etc/arkya/internal-ca/ca.crt
