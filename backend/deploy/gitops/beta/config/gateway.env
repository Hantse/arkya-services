ASPNETCORE_ENVIRONMENT=Production
DOTNET_EnableDiagnostics=0
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__System.Net.Http.HttpClient=Warning
ASPNETCORE_HTTP_PORTS=8080;8081
AllowedHosts=api.arkya.online;admin.arkya.online
ProxyTrust__KnownNetworks__0=192.168.100.0/24
ProxyTrust__ForwardLimit=1
Management__Port=8081
Gateway__CharactersEnabled=true
Gateway__AdminEnabled=true
Gateway__AdminHost=admin.arkya.online
Gateway__AdminAddress=http://arkya-admin.arkya-operations.svc.cluster.local:8080/
ReverseProxy__Clusters__identity__Destinations__primary__Address=http://arkya-identity.arkya-identity.svc.cluster.local:8080/
ReverseProxy__Clusters__characters__Destinations__primary__Address=http://arkya-characters.arkya-identity.svc.cluster.local:8080/
Logging__LogLevel__Yarp.ReverseProxy=Warning
