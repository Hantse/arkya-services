# syntax=docker/dockerfile:1
ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0-noble@sha256:0d99ebf1ccad15037b5c98c9fe8979d6b8dbac23812feae2277a0b277b5c5ffa
ARG RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0-noble@sha256:d5633778c754e89a386882eddf8dbee6942447a8a4b8267c19cf1e1158d0b0ac

FROM --platform=$BUILDPLATFORM ${SDK_IMAGE} AS build
ARG TARGETARCH
ARG APPLICATION
WORKDIR /source
COPY src/ src/
RUN case "${APPLICATION}" in \
      Arkya.Identity.Api|Arkya.Gateway|Arkya.Characters.Api|Arkya.Content.Api|Arkya.Admin|Arkya.Realms.Api|Arkya.Backend.Api|Arkya.Inference.Api|Arkya.Reports.Api) ;; \
      *) echo 'Select a supported APPLICATION build argument.' >&2; exit 1 ;; \
    esac \
    && dotnet restore "src/${APPLICATION}/${APPLICATION}.csproj" --arch "${TARGETARCH}" \
    && dotnet publish "src/${APPLICATION}/${APPLICATION}.csproj" --no-restore --configuration Release \
       --arch "${TARGETARCH}" --self-contained false /p:UseAppHost=false --output /app/publish

FROM ${RUNTIME_IMAGE} AS final
ARG APPLICATION
WORKDIR /app
ENV ARKYA_APPLICATION=${APPLICATION} \
    ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_EnableDiagnostics=0 \
    TMPDIR=/tmp
COPY --from=build /app/publish/ ./
USER 1654:1654
EXPOSE 8080 8081 8443
ENTRYPOINT ["sh", "-c", "exec dotnet \"$ARKYA_APPLICATION.dll\" \"$@\"", "--"]
