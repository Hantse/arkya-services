@page "/CreateRealm"
@model RealmCreateModel
@using Arkya.Admin.Realms
@{
    ViewData["Title"] = Model.IsEditing ? "Edit realm plan" : "Create a realm";
}
<link rel="stylesheet" href="~/realm-create-islands.css" asp-append-version="true" />
<a class="text-link" asp-page="/Realms">← All realms</a>
<header class="page-header realm-header">
    <div><div class="eyebrow">WORLD / CONFIGURATION</div><h1>@(Model.IsEditing ? "Edit plan" : "Create a realm")</h1><p class="intro">Define the world, its target and the distribution of its dedicated servers.</p></div>
    <a class="button secondary" asp-page="/Realms">Back to list</a>
</header>
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/RealmCreate" asp-route-editRealmId="@Model.EditRealmId">Try again</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (!Model.Enabled)
{
    <div class="panel empty-state"><div class="empty-mark" aria-hidden="true">◇</div><h2>Realm management is disabled</h2><p>Enable the Realms service connection in the administration configuration to prepare a world.</p></div>
}
else if (Model.Loaded)
{
    <div class="realm-create-workspace">
        <section aria-labelledby="create-heading">
            <div class="section-heading"><h2 id="create-heading">@(Model.IsEditing ? "Edit realm plan" : "Prepare a realm")</h2></div>
            <form method="post" asp-page-handler="@(Model.IsEditing ? "SaveTopology" : "Create")" class="panel realm-form realm-create-form">
                @if (Model.IsEditing)
                {
                    <input type="hidden" asp-for="EditRealmId" /><input type="hidden" asp-for="ExpectedRevision" />
                    <input type="hidden" asp-for="Input.RealmId" /><input type="hidden" asp-for="Input.DisplayName" /><input type="hidden" asp-for="Input.TargetId" />
                    <p class="realm-edit-identity"><strong>@Model.Input.DisplayName</strong><small>@Model.Input.RealmId · @Model.Input.TargetId · revision @Model.ExpectedRevision</small></p>
                }
                else
                {
                <div class="field"><label asp-for="Input.DisplayName">World name</label><input asp-for="Input.DisplayName" maxlength="80" placeholder="The Dawnlands" required /></div>
                <div class="field"><label asp-for="Input.RealmId">Permanent ID</label><input asp-for="Input.RealmId" class="mono" minlength="3" maxlength="31" pattern="[a-z][a-z0-9\-]{1,29}[a-z0-9]" placeholder="terres-aube" required aria-describedby="realm-id-help" /><small id="realm-id-help">3 to 31 characters: lowercase letters, digits and hyphens.</small></div>
                <div class="field"><label asp-for="Input.TargetId">Deployment target</label><select asp-for="Input.TargetId" required><option value="">Choose a target</option>@foreach (var target in Model.Options.Targets) { <option value="@target.Id">@target.DisplayName · @target.Namespace</option> }</select></div>
                }
                <div class="field"><label asp-for="Input.ProfileId">Server profile</label><select asp-for="Input.ProfileId" required><option value="">Choose a profile</option>@foreach (var profile in Model.Options.Profiles) { <option value="@profile.Id">@profile.DisplayName · @profile.Servers.Length server(s)</option> }</select></div>
                <fieldset class="realm-plan" data-island-catalog-id="starter-island" data-island-catalog-image="@RealmIslandPresentation.ImagePath("starter-island")" data-island-catalog-label="@RealmIslandPresentation.Label("starter-island")" data-island-catalog-mapped="@RealmIslandPresentation.ImageMatchesPlan(new("starter-island", 1, 1536, 1536)).ToString().ToLowerInvariant()" data-partition-labels="@System.Text.Json.JsonSerializer.Serialize(Enumerable.Range(0, 64).Select(RealmIslandPresentation.PartitionLabel))">
                    <legend>Dedicated server distribution</legend>
                    <label class="realm-plan-toggle"><input asp-for="Input.ConfigureTopology" /> Configure Areas, instances and raids</label>
                    <small>Uncheck to use the selected profile's fixed layout.</small>
                    <small>A realm can contain multiple Areas. Each Area is a complete, continuous map, divided into partitions each managed by one dedicated server. Instance and raid servers form separate pools.</small>
                    @for (var index = 0; index < Model.Input.Islands.Count; index++)
                    {
                        var island = Model.Input.Islands[index];
                        var grid = RealmCreateModel.PreviewGrid(island);
                        var imagePath = RealmIslandPresentation.ImagePath(string.IsNullOrWhiteSpace(island.ContentId) ? island.IslandId ?? "" : island.ContentId);
                        var imageMatchesPlan = RealmIslandPresentation.ImageMatchesPlan(new(island.IslandId ?? "", island.DedicatedCount, island.Width, island.Depth, island.OriginX, island.OriginZ) { ContentId = island.ContentId });
                        var gridSummary = grid is { } cells ? $"{cells.Columns} × {cells.Rows} = {cells.Columns * cells.Rows} dedicated server(s)" : "Correct the dimensions or grid to display the preview.";
                        <div class="realm-island-input realm-create-island" data-island-editor>
                            <div class="realm-create-island-controls">
                            <div class="field"><label asp-for="Input.Islands[index].IslandId">Area ID</label><input asp-for="Input.Islands[index].IslandId" class="mono" maxlength="20" placeholder="starter-island" data-island-id /><small>3 to 20 characters. Add each Area in the realm, including future maps.</small></div>
                            <div class="field"><label asp-for="Input.Islands[index].ContentId">Map content ID</label><input asp-for="Input.Islands[index].ContentId" class="mono" maxlength="31" placeholder="Use the Area ID" data-island-content-id /><small>Leave blank to use the Area ID. Areas can share content while keeping separate identities. The dedicated build must include this map content.</small></div>
                            <label class="realm-plan-toggle"><input asp-for="Input.Islands[index].UseGrid" data-use-grid /> Choose an X × Y grid</label>
                            <small data-grid-legacy-note hidden="@island.UseGrid">The existing dedicated server count is retained. Check to choose an explicit grid.</small>
                            <div class="realm-create-grid-inputs">
                                <div class="field"><label asp-for="Input.Islands[index].GridColumns">X columns</label><input asp-for="Input.Islands[index].GridColumns" type="number" min="1" max="64" step="1" inputmode="numeric" placeholder="X" data-grid-columns /></div>
                                <span aria-hidden="true">×</span>
                                <div class="field"><label asp-for="Input.Islands[index].GridRows">Y rows</label><input asp-for="Input.Islands[index].GridRows" type="number" min="1" max="64" step="1" inputmode="numeric" placeholder="Y" data-grid-rows /></div>
                            </div>
                            <small>Y in the preview corresponds to Z in the world. One cell = one Area partition = one dedicated server.</small>
                            <div class="field realm-create-dedicated-count"><label asp-for="Input.Islands[index].DedicatedCount">Dedicated servers for this Area</label><input asp-for="Input.Islands[index].DedicatedCount" type="number" min="1" max="64" readonly="@island.UseGrid" data-dedicated-count /></div>
                            <output class="realm-create-grid-summary" data-grid-summary aria-live="polite">@gridSummary</output>
                            </div>
                            <figure class="realm-create-island-preview">
                                <div class="realm-create-island-map" data-island-preview role="img" aria-label="@($"{RealmIslandPresentation.Label(island.IslandId ?? "")} : {gridSummary}. X points right, Y / Z points up.")">
                                    <img src="@imagePath" alt="" data-island-image hidden="@(imagePath is null)" />
                                    <span class="realm-create-island-placeholder" data-island-placeholder hidden="@(imagePath is not null)">Visual unavailable for this Area</span>
                                    <table class="realm-create-island-overlay @(grid is { } dense && (dense.Columns > 12 || dense.Rows > 12) ? "is-dense" : null)" aria-hidden="true"><tbody data-grid-cells>
                                    @if (grid is { } preview)
                                    {
                                        @for (var row = preview.Rows - 1; row >= 0; row--)
                                        {
                                            <tr>@for (var column = 0; column < preview.Columns; column++) { <td><span>@RealmIslandPresentation.PartitionLabel(row * preview.Columns + column)</span></td> }</tr>
                                        }
                                    }
                                    </tbody></table>
                                    <span class="realm-create-map-axis realm-create-map-x" aria-hidden="true">X →</span><span class="realm-create-map-axis realm-create-map-y" aria-hidden="true">Y / Z ↑</span>
                                </div>
                                <figcaption><strong data-island-label>@RealmIslandPresentation.Label(island.IslandId ?? "")</strong><small data-island-image-note>@(imagePath is null ? "No catalogue image for this ID." : imageMatchesPlan ? "Terrain map · X points right, Y / Z points up." : "Illustration · plan dimensions differ from the view.")</small></figcaption>
                            </figure>
                            <details class="realm-create-island-dimensions">
                                <summary>Dimensions and world position</summary>
                            <div class="realm-island-dimensions">
                                <div class="field"><label asp-for="Input.Islands[index].Width">Width (X)</label><input asp-for="Input.Islands[index].Width" type="number" min="1" max="1000000" step="any" data-island-width /></div>
                                <div class="field"><label asp-for="Input.Islands[index].Depth">Depth (Z)</label><input asp-for="Input.Islands[index].Depth" type="number" min="1" max="1000000" step="any" data-island-depth /></div>
                                <div class="field"><label asp-for="Input.Islands[index].OriginX">Origin X</label><input asp-for="Input.Islands[index].OriginX" type="number" min="-10000000" max="10000000" step="any" data-island-origin-x /></div>
                                <div class="field"><label asp-for="Input.Islands[index].OriginZ">Origin Z</label><input asp-for="Input.Islands[index].OriginZ" type="number" min="-10000000" max="10000000" step="any" data-island-origin-z /></div>
                            </div>
                            <small>World X/Z coordinates. A 1,000 × 1,000 Area with a 2 × 2 grid produces four 500 × 500 partitions.</small>
                            </details>
                            <button class="text-button danger" type="submit" asp-page-handler="RemoveIsland" name="removeIslandIndex" value="@index" formnovalidate>Remove this Area</button>
                        </div>
                    }
                    <button class="button secondary full-width" type="submit" asp-page-handler="AddIsland" formnovalidate disabled="@(Model.Input.Islands.Count >= 32)">Add an Area</button>
                    <section class="realm-portals" aria-labelledby="realm-portals-heading">
                        <h3 id="realm-portals-heading">Automatic Area portals</h3>
                        <p class="muted">Entering a source rectangle transfers the player to the target Area and arrival position. Portals are one-way; add a separate return portal when needed. Avoid overlapping source triggers.</p>
                        <datalist id="realm-area-ids">@foreach (var area in Model.Input.Islands) { <option value="@area.IslandId"></option> }</datalist>
                        @for (var index = 0; index < Model.Input.AreaTransitions.Count; index++)
                        {
                            <fieldset class="realm-portal-editor">
                                <legend>Portal @(index + 1)</legend>
                                <div class="realm-island-dimensions">
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].Id">Portal ID</label><input asp-for="Input.AreaTransitions[index].Id" class="mono" maxlength="31" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].SourceAreaId">Source Area ID</label><input asp-for="Input.AreaTransitions[index].SourceAreaId" class="mono" maxlength="20" list="realm-area-ids" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].TargetAreaId">Target Area ID</label><input asp-for="Input.AreaTransitions[index].TargetAreaId" class="mono" maxlength="20" list="realm-area-ids" /></div>
                                </div>
                                <h4>Source trigger rectangle (X / Z)</h4>
                                <div class="realm-island-dimensions">
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].SourceMinX">Minimum X</label><input asp-for="Input.AreaTransitions[index].SourceMinX" type="number" step="any" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].SourceMinZ">Minimum Z</label><input asp-for="Input.AreaTransitions[index].SourceMinZ" type="number" step="any" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].SourceMaxX">Maximum X</label><input asp-for="Input.AreaTransitions[index].SourceMaxX" type="number" step="any" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].SourceMaxZ">Maximum Z</label><input asp-for="Input.AreaTransitions[index].SourceMaxZ" type="number" step="any" /></div>
                                </div>
                                <h4>Arrival position</h4>
                                <div class="realm-island-dimensions">
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].TargetX">Arrival X</label><input asp-for="Input.AreaTransitions[index].TargetX" type="number" min="-100000" max="100000" step="any" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].TargetY">Arrival Y</label><input asp-for="Input.AreaTransitions[index].TargetY" type="number" min="-100000" max="100000" step="any" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].TargetZ">Arrival Z</label><input asp-for="Input.AreaTransitions[index].TargetZ" type="number" min="-100000" max="100000" step="any" /></div>
                                </div>
                                <label class="realm-plan-toggle"><input asp-for="Input.AreaTransitions[index].UseTargetForward" /> Set an arrival direction</label>
                                <small>Unchecked preserves the player's direction. When set, use a non-zero direction with length at most 1.</small>
                                <div class="realm-island-dimensions">
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].ForwardX">Direction X</label><input asp-for="Input.AreaTransitions[index].ForwardX" type="number" min="-1.01" max="1.01" step="any" /></div>
                                    <div class="field"><label asp-for="Input.AreaTransitions[index].ForwardZ">Direction Z</label><input asp-for="Input.AreaTransitions[index].ForwardZ" type="number" min="-1.01" max="1.01" step="any" /></div>
                                </div>
                                <button class="text-button danger" type="submit" asp-page-handler="RemoveTransition" name="removeTransitionIndex" value="@index" formnovalidate>Remove this portal</button>
                            </fieldset>
                        }
                        <button class="button secondary full-width" type="submit" asp-page-handler="AddTransition" formnovalidate disabled="@(Model.Input.AreaTransitions.Count >= 64)">Add a portal</button>
                        <small>Up to 64 portals. Deployment requires a runtime that supports these Area contents and transitions.</small>
                    </section>
                    <div class="field"><label asp-for="Input.InstanceDedicatedCount">Instance servers</label><input asp-for="Input.InstanceDedicatedCount" type="number" min="0" max="64" /></div>
                    <div class="field"><label asp-for="Input.RaidDedicatedCount">Raid servers</label><input asp-for="Input.RaidDedicatedCount" type="number" min="0" max="64" /></div>
                    <small>Up to 32 Areas and 256 dedicated servers per realm. Creation retains this plan. Deployment and transfers between partitions require a runtime compatible with each Area's content.</small>
                    @foreach (var profile in Model.Options.Profiles.Where(profile => !profile.TopologySupported))
                    {
                        <small>@profile.DisplayName : plan saving available, deployment of this topology unavailable.</small>
                    }
                </fieldset>
                <div class="realm-create-actions"><button class="button primary" type="submit" disabled="@(Model.Options.Targets.Length == 0 || Model.Options.Profiles.Length == 0 || Model.IsEditing && Model.ExpectedRevision is null)">@(Model.IsEditing ? "Save plan" : "Create realm")</button><a class="button secondary" asp-page="/Realms">Cancel</a></div>
                <small>Creation saves the configuration. Deployment starts from the realm details page.</small>
            </form>
            @if (!Model.Options.DeploymentEnabled) { <div class="workflow-note"><strong>Deployment disabled</strong><p>You can prepare realms. Deployment is enabled through the service configuration.</p></div> }
            @if (Model.Options.Targets.Length == 0 || Model.Options.Profiles.Length == 0) { <div class="workflow-note"><strong>Incomplete configuration</strong><p>Add at least one target and profile to the Realms service before creating a world.</p></div> }
        </section>
    </div>
}
<script src="~/realm-create-islands.js" asp-append-version="true" defer></script>
