@page
@model InferenceModel
@using Arkya.Admin.Inference
@{
    ViewData["Title"] = "Inference";
}
<header class="page-header">
    <div><div class="eyebrow">NPC / CPU INFERENCE</div><h1>Inference machines</h1><p class="intro">Connect your machines, choose models and allocate their CPU threads.</p></div>
    <a class="button secondary" asp-page="/Inference">Refresh</a>
</header>
@if (Model.Notice is not null) { <div class="alert success" role="status">@Model.Notice</div> }
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/Inference">Try again</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (Model.InstallationGrant is { } grant)
{
    <section class="panel report-form" aria-labelledby="installation-heading">
        <div class="section-heading"><h2 id="installation-heading">Installation ready</h2><span class="badge">Key shown only once</span></div>
        <div class="field">
            <label for="installation-token">Temporary installation key</label>
            <textarea id="installation-token" readonly rows="3" autocomplete="off" spellcheck="false" class="mono" aria-describedby="installation-token-help">@grant.Token</textarea>
            <small id="installation-token-help">Copy this key now: only one machine can use it, before @grant.ExpiresAt.ToUniversalTime().ToString("dd/MM/yyyy 'at' HH:mm:ss 'UTC'"). It will not be shown again after leaving this response.</small>
        </div>
        <p>On the machine to connect, extract the agent package, then run this command in its folder:</p>
        <p class="report-description"><code>.\Install.cmd -BackendUrl https://api.arkya.online</code></p>
        <small>Paste the key at the secure prompt. Installation creates the agent using the machine's Windows name; no ID needs to be prepared here. You can then adjust models and threads below.</small>
    </section>
}
@if (Model.Created is { } created)
{
    <section class="panel report-form" aria-labelledby="enrollment-heading">
        <div class="section-heading"><h2 id="enrollment-heading">Connect @created.Agent.DisplayName</h2><span class="badge">Token shown only once</span></div>
        <div class="field">
            <label for="agent-token">This machine's token</label>
            <textarea id="agent-token" readonly rows="3" autocomplete="off" spellcheck="false" class="mono" aria-describedby="agent-token-help">@created.AgentToken</textarea>
            <small id="agent-token-help">Save it now. It will not be shown again after leaving this response. It is only used to authenticate this agent.</small>
        </div>
        <p>From the agent folder on the machine to connect, run:</p>
        <p class="report-description"><code>./Install-Agent.ps1 -BackendUrl 'https://api.arkya.online' -AgentId '@created.Agent.AgentId' -AgentToken (Read-Host 'Agent token' -AsSecureString)</code></p>
        <small>At the secure prompt, paste the token above. The command will retrieve the @created.Agent.DesiredWorkers.Length requested worker(s); it contains no secret.</small>
    </section>
}
@if (!Model.Enabled)
{
    <div class="panel empty-state"><div class="empty-mark" aria-hidden="true">◇</div><h2>Inference management is disabled</h2><p>Enable the Inference service connection in the administration configuration.</p></div>
}
else if (Model.Loaded)
{
    <div class="realms-workspace">
        <section aria-labelledby="agents-heading">
            <div class="section-heading"><h2 id="agents-heading">Saved machines</h2><span class="muted">@Model.Agents.Length machine(s)</span></div>
            @if (Model.Agents.Length == 0)
            {
                <div class="panel empty-state"><div class="empty-mark" aria-hidden="true">◇</div><h3>Connect the first machine</h3><p>Prepare an installation key, then run the installer on the machine. It will appear here automatically.</p></div>
            }
            @foreach (var agent in Model.Agents)
            {
                <details class="panel catalog-entry" open>
                    <summary>
                        <strong>@agent.DisplayName</strong>
                        <span class="realm-status @(agent.Online ? "ready" : "draft")">@(agent.Online ? "Online" : agent.LastSeenAt is null ? "Awaiting connection" : "Offline")</span>
                        <span class="muted">@agent.ObservedWorkers.Length observed / @agent.DesiredWorkers.Length requested</span>
                    </summary>
                    <div class="catalog-detail">
                        <dl class="realm-facts">
                            <div><dt>Agent / machine</dt><dd><span class="mono">@agent.AgentId</span> · @(agent.MachineName ?? "Machine name not received")</dd></div>
                            <div><dt>Last check-in</dt><dd>@(agent.LastSeenAt?.ToUniversalTime().ToString("dd/MM/yyyy HH:mm:ss 'UTC'") ?? "No check-in received")</dd></div>
                            <div><dt>Reported hardware</dt><dd>@(agent.LogicalProcessors?.ToString() ?? "—") logical processors · @(agent.TotalMemoryMb?.ToString("N0") ?? "—") MiB of memory</dd></div>
                            <div><dt>Agent version</dt><dd>@(agent.Version ?? "Version not received")<small>CPU inference only · model configurable per worker.</small></dd></div>
                            <div><dt>Requested budget</dt><dd>@agent.DesiredWorkers.Sum(worker => worker.Threads) threads · @agent.DesiredWorkers.Length / @agent.MaxWorkers workers<small>@agent.ThreadsPerWorker default threads for a new worker.</small></dd></div>
                            @if (agent.DemoPort is { } port) { <div><dt>Local demo</dt><dd>Port @port on this machine</dd></div> }
                        </dl>
                        @if (!agent.Online)
                        {
                            <div class="workflow-note"><strong>Awaiting next check-in</strong><p>Creations, changes and deletions remain saved. The agent will apply them when it reconnects; the observations below may be outdated.</p></div>
                        }
                        @if (agent.LastError is not null)
                        {
                            <div class="alert error" role="status">The agent reports an error. Check its local logs, then refresh this page.</div>
                        }
                        <div class="table-scroll">
                            <table class="realm-table inference-table">
                                <caption class="sr-only">Workers for @agent.DisplayName : requested configuration and latest observation</caption>
                                <thead><tr><th scope="col">Worker</th><th scope="col">Requested configuration</th><th scope="col">Last observed state</th><th scope="col">Action</th></tr></thead>
                                <tbody>
                                @foreach (var worker in agent.DesiredWorkers)
                                {
                                    var observed = agent.ObservedWorkers.FirstOrDefault(item => item.WorkerId == worker.WorkerId);
                                    var fieldId = agent.AgentId + "-" + worker.WorkerId;
                                    <tr>
                                        <th scope="row" class="mono report-description" title="@worker.WorkerId">@worker.WorkerId</th>
                                        <td>
                                            <small>@Model.ModelLabel(worker.ModelId) · @worker.Threads requested threads</small>
                                            <form method="post" asp-page-handler="UpdateWorker" class="inference-worker-form">
                                                <input type="hidden" name="agentId" value="@agent.AgentId" />
                                                <input type="hidden" name="workerId" value="@worker.WorkerId" />
                                                <div class="field">
                                                    <label for="model-@fieldId">Model</label>
                                                    <select id="model-@fieldId" name="modelId" required disabled="@(!Model.ModelsLoaded)">
                                                        @if (!Model.Models.Any(model => model.ModelId == worker.ModelId)) { <option value="" selected>Choose a model</option> }
                                                        @foreach (var option in Model.Models) { <option value="@option.ModelId" selected="@(option.ModelId == worker.ModelId)">@option.Label</option> }
                                                    </select>
                                                </div>
                                                <div class="field"><label for="threads-@fieldId">Threads</label><input id="threads-@fieldId" name="threads" type="number" min="1" max="24" value="@worker.Threads" required disabled="@(!Model.ModelsLoaded)" /></div>
                                                <button class="button secondary" type="submit" disabled="@(!Model.ModelsLoaded)" aria-label="Edit worker @worker.WorkerId on @agent.DisplayName">Edit</button>
                                            </form>
                                        </td>
                                        <td>
                                            @if (observed is null)
                                            {
                                                <span class="realm-status pending">Startup requested</span>
                                            }
                                            else
                                            {
                                                <span class="realm-status @(agent.Online ? InferencePresentation.StateClass(observed.State) : "draft")">@InferencePresentation.StateLabel(observed.State)</span>
                                                <small>@Model.ModelLabel(observed.ModelId) · @observed.Threads observed threads</small>
                                                <small>PID @(observed.Pid?.ToString() ?? "—") · port @observed.Port</small>
                                                @if (observed.Threads != worker.Threads || observed.ModelId != worker.ModelId) { <span class="realm-status pending">Restart requested</span><small>Awaiting application of the requested model and threads.</small> }
                                                @if (observed.LastError is not null) { <small>Error reported; check the machine logs.</small> }
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="DeleteWorker">
                                                <input type="hidden" name="agentId" value="@agent.AgentId" />
                                                <input type="hidden" name="workerId" value="@worker.WorkerId" />
                                                <button type="submit" class="text-button danger" aria-label="Delete worker @worker.WorkerId on @agent.DisplayName">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                @foreach (var observed in agent.ObservedWorkers.Where(worker => !agent.DesiredWorkers.Any(desired => desired.WorkerId == worker.WorkerId)))
                                {
                                    <tr>
                                        <th scope="row" class="mono report-description" title="@observed.WorkerId">@observed.WorkerId</th>
                                        <td>@Model.ModelLabel(observed.ModelId)<small>@observed.Threads observed threads</small></td>
                                        <td><span class="realm-status pending">Stop requested</span><small>Last observation: @InferencePresentation.StateLabel(observed.State)</small></td>
                                        <td><span class="muted">Awaiting agent</span></td>
                                    </tr>
                                }
                                @if (agent.DesiredWorkers.Length == 0 && agent.ObservedWorkers.Length == 0)
                                {
                                    <tr><td colspan="4">No workers on this machine.</td></tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <form method="post" asp-page-handler="AddWorker" class="workflow-note">
                            <input type="hidden" name="agentId" value="@agent.AgentId" />
                            <div class="field">
                                <label for="new-model-@agent.AgentId">New worker model</label>
                                <select id="new-model-@agent.AgentId" name="modelId" required disabled="@(!Model.ModelsLoaded)">
                                    @foreach (var option in Model.Models) { <option value="@option.ModelId" selected="@(option.ModelId == Arkya.ServiceDefaults.Inference.InferenceModels.DefaultModelId)">@option.Label</option> }
                                </select>
                            </div>
                            <label for="threads-@agent.AgentId">New worker threads</label>
                            <div class="objective-fields">
                                <input id="threads-@agent.AgentId" name="threads" type="number" min="1" max="24" value="@agent.ThreadsPerWorker" required disabled="@(!Model.ModelsLoaded)" />
                                <button type="submit" class="button secondary" disabled="@(!Model.ModelsLoaded || agent.DesiredWorkers.Length >= agent.MaxWorkers || agent.DesiredWorkers.Sum(worker => worker.Threads) >= 96)">Add a worker</button>
                            </div>
                            <small>The limit is @agent.MaxWorkers workers for this machine and 96 requested threads in total.</small>
                        </form>
                        @if (agent.DesiredWorkers.Length == 0 && agent.ObservedWorkers.Length == 0)
                        {
                            <form method="post" asp-page-handler="DeleteAgent" class="editor-actions">
                                <input type="hidden" name="agentId" value="@agent.AgentId" />
                                <button type="submit" class="text-button danger">Delete this empty machine</button>
                            </form>
                        }
                    </div>
                </details>
            }
            <div class="workflow-note"><strong>One machine, multiple workers</strong><p>Each agent supervises its inference processes. Changing a model or its thread count restarts the affected worker. Actions save the desired configuration; “Ready” comes from the latest state sent by the agent.</p></div>
        </section>
        <aside aria-labelledby="connect-heading">
            <div class="section-heading"><h2 id="connect-heading">Connect a machine</h2></div>
            <form method="post" asp-page-handler="PrepareInstallation" class="panel realm-form">
                <p>Prepare a temporary key, then run the Windows installer. The agent will register automatically; no machine is created at this step.</p>
                <button class="button primary full-width" type="submit">Prepare installation</button>
                <small>One key per machine, shown only once. The installer requests the key at a secure prompt.</small>
            </form>
            <details class="panel catalog-entry" open="@(!ViewData.ModelState.IsValid)">
                <summary><strong>Advanced manual creation</strong></summary>
                <div class="catalog-detail">
                <p class="muted">Reserve a permanent ID and configure workers before installing the agent.</p>
                <form method="post" asp-page-handler="Create" class="realm-form">
                <div class="field"><label asp-for="Input.DisplayName">Machine name</label><input asp-for="Input.DisplayName" maxlength="80" placeholder="Office CPU server" required /></div>
                <div class="field"><label asp-for="Input.AgentId">Permanent ID</label><input asp-for="Input.AgentId" class="mono" minlength="3" maxlength="48" pattern="[a-z][a-z0-9\-]*[a-z0-9]" placeholder="cpu-bureau" required aria-describedby="agent-id-help" /><small id="agent-id-help">3 to 48 characters: lowercase letters, digits and hyphens, starting with a letter.</small></div>
                <div class="field"><label asp-for="Input.InitialWorkers">Initial workers</label><input asp-for="Input.InitialWorkers" type="number" min="0" max="12" required /></div>
                <div class="field"><label asp-for="Input.ThreadsPerWorker">Threads per worker</label><input asp-for="Input.ThreadsPerWorker" type="number" min="1" max="24" required /></div>
                <div class="field"><label asp-for="Input.MaxWorkers">Maximum workers</label><input asp-for="Input.MaxWorkers" type="number" min="1" max="12" required /></div>
                <div class="field"><label asp-for="Input.ModelId">Initial worker model</label><select asp-for="Input.ModelId" required disabled="@(!Model.ModelsLoaded)"><option value="">Choose a model</option>@foreach (var option in Model.Models) { <option value="@option.ModelId">@option.Label</option> }</select></div>
                <button class="button secondary full-width" type="submit" disabled="@(!Model.ModelsLoaded)">Create this machine's agent</button>
                <small>The connection token will be shown once; no process starts before the agent is installed on the machine.</small>
                </form>
                </div>
            </details>
        </aside>
    </div>
}
