@page
@model PublicationsModel
@using Arkya.Admin.Content
@{
    ViewData["Title"] = "News and releases";
}
<header class="page-header">
    <div><div class="eyebrow">COMMUNITY / PUBLICATIONS</div><h1>News and releases</h1><p class="intro">Prepare game news and notes for each update.</p></div>
    @if (Model.Enabled) { <a class="button primary" asp-page="/Publication">Create a draft</a> }
</header>
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/Publications" asp-route-kind="@Model.Kind" asp-route-language="@Model.Language">Try again</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (!Model.Enabled)
{
    <div class="panel empty-state"><h2>Publication management is disabled</h2><p>The Content service connection must be enabled in the administration configuration.</p></div>
}
else
{
    <form method="get" class="panel report-filters">
        <div class="field"><label asp-for="Kind">Type</label><select asp-for="Kind"><option value="">All types</option><option value="news">News</option><option value="release-note">Release notes</option></select></div>
        <div class="field"><label asp-for="Language">Language</label><select asp-for="Language"><option value="">All languages</option><option value="fr">French</option><option value="en">English</option></select></div>
        <input type="hidden" asp-for="Limit" />
        <button type="submit" class="button secondary">Filter</button><a class="text-link" asp-page="/Publications">Clear filters</a>
    </form>
    @if (Model.Publications is { } posts)
    {
        @if (posts.Items.Length == 0)
        {
            <div class="panel empty-state"><h2>No publications on this page</h2><p>Create a draft or adjust the filters to find a publication.</p></div>
        }
        else
        {
            <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">News and release notes</caption><thead><tr><th scope="col">Publication</th><th scope="col">Type and language</th><th scope="col">Visibility</th><th scope="col">Modified</th></tr></thead><tbody>
            @foreach (var post in posts.Items)
            {
                <tr><th scope="row"><a asp-page="/Publication" asp-route-id="@post.Id">@post.Title</a>@if (post.GameVersion is not null) { <small>Version @post.GameVersion</small> }</th><td>@ContentPublicationPresentation.KindLabel(post.Kind)<small>@ContentPublicationPresentation.LanguageLabel(post.Language)</small></td><td><span class="realm-status @(post.PublishedAt is null ? "pending" : "ready")">@(post.PublishedAt is null ? "Draft" : "Published")</span></td><td><time datetime="@post.UpdatedAt.ToString("O")">@post.UpdatedAt.ToUniversalTime().ToString("dd/MM/yyyy HH:mm 'UTC'")</time></td></tr>
            }
            </tbody></table></div>
        }
        <nav class="report-pagination" aria-label="Publication pages">
            @if (Model.HasPrevious) { <a class="button secondary" asp-page="/Publications" asp-route-kind="@Model.Kind" asp-route-language="@Model.Language" asp-route-offset="@Math.Max(0, Model.Offset - Model.Limit)" asp-route-limit="@Model.Limit">Previous</a> }
            @if (Model.HasNext) { <a class="button secondary" asp-page="/Publications" asp-route-kind="@Model.Kind" asp-route-language="@Model.Language" asp-route-offset="@(Model.Offset + Model.Limit)" asp-route-limit="@Model.Limit">Next</a> }
        </nav>
    }
}
