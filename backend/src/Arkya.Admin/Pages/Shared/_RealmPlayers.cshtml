@model RealmModel
@{ var realm = Model.Realm!; }
<section aria-labelledby="realm-players-heading">
    <div class="section-heading"><div><h2 id="realm-players-heading">Realm players</h2><p class="muted">Characters bound to @realm.DisplayName, with their current presence.</p></div>@if (Model.Characters is { } result) { <span class="muted">@result.Total character(s)</span> }</div>
    @if (!Model.CharactersEnabled)
    {
        <div class="panel empty-state"><h3>Player viewing is disabled</h3><p>Configure the private Characters connection to view this realm's characters and their presence.</p></div>
    }
    else
    {
        <form method="get" asp-page="/Realm" asp-route-realmId="@realm.RealmId" class="panel filter-bar">
            <input type="hidden" name="section" value="players" />
            <div class="field"><label asp-for="Search">Character</label><input asp-for="Search" maxlength="100" placeholder="Character name or ID" /></div>
            <div class="field"><label asp-for="OnlineOnly">Presence</label><select asp-for="OnlineOnly"><option value="false">All characters</option><option value="true">Online only</option></select></div>
            <div class="field"><label asp-for="PageSize">Results per page</label><select asp-for="PageSize"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
            <button class="button primary" type="submit">Search</button>
            <a class="button secondary" asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players">Clear</a>
        </form>
        @if (Model.CharactersError is not null)
        {
            <div class="alert error" role="alert">@Model.CharactersError <a asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageNumber="@Model.PageNumber" asp-route-pageSize="@Model.PageSize">Try again</a></div>
        }
        @if (Model.Characters is { } characters)
        {
            @if (characters.Items.Length == 0)
            {
                <div class="panel empty-state"><h3>No characters on this page</h3><p>Change the filters or return to the first page.</p><a asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageSize="@Model.PageSize">First page</a></div>
            }
            else
            {
                <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Realm characters @realm.DisplayName</caption><thead><tr><th scope="col">Character</th><th scope="col">Owning account</th><th scope="col">Race / silhouette</th><th scope="col">Presence</th><th scope="col">Created UTC</th></tr></thead><tbody>
                @foreach (var character in characters.Items)
                {
                    <tr><th scope="row">@character.DisplayName<small class="mono">@character.CharacterId</small></th><td><a class="mono" href="@Model.AccountUrl(character.AccountId)">@character.AccountId</a><small>@(Model.AccountsAreCentral ? "Manage account in general administration ↗" : "Manage account")</small></td><td>@character.Race / @character.Gender</td><td><span class="realm-status @(character.IsOnline ? "ready" : "draft")">@(character.IsOnline ? "Online" : "Offline")</span>@if (character.IsOnline && character.LeaseExpiresAt is { } expiresAt) { <small>Lease expires @expiresAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss") UTC</small> }</td><td>@character.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</td></tr>
                }
                </tbody></table></div>
            }
            <nav class="pagination" aria-label="Realm player pagination">
                @if (Model.PageNumber > 1) { <a class="button secondary" asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Previous</a> }
                <span class="muted">Page @characters.Page</span>
                @if (Model.HasNextCharacters) { <a class="button secondary" asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Next</a> }
            </nav>
            <p class="muted">Presence corresponds to an active game lease. To disconnect a character or request a save, use <a asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="game">this realm's in-game actions</a>.</p>
        }
    }
</section>
