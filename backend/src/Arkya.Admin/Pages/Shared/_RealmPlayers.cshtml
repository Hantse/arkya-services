@model RealmModel
@{ var realm = Model.Realm!; }
<section aria-labelledby="realm-players-heading">
    <div class="section-heading"><div><h2 id="realm-players-heading">Joueurs du realm</h2><p class="muted">Personnages rattachés à @realm.DisplayName, avec leur présence actuelle.</p></div>@if (Model.Characters is { } result) { <span class="muted">@result.Total personnage(s)</span> }</div>
    @if (!Model.CharactersEnabled)
    {
        <div class="panel empty-state"><h3>La consultation des joueurs est désactivée</h3><p>Configurez la connexion privée à Characters pour consulter les personnages de ce realm et leur présence.</p></div>
    }
    else
    {
        <form method="get" asp-page="/Realm" asp-route-realmId="@realm.RealmId" class="panel filter-bar">
            <input type="hidden" name="section" value="players" />
            <div class="field"><label asp-for="Search">Personnage</label><input asp-for="Search" maxlength="100" placeholder="Nom ou ID du personnage" /></div>
            <div class="field"><label asp-for="OnlineOnly">Présence</label><select asp-for="OnlineOnly"><option value="false">Tous les personnages</option><option value="true">En ligne uniquement</option></select></div>
            <div class="field"><label asp-for="PageSize">Résultats par page</label><select asp-for="PageSize"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div>
            <button class="button primary" type="submit">Rechercher</button>
            <a class="button secondary" asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players">Effacer</a>
        </form>
        @if (Model.CharactersError is not null)
        {
            <div class="alert error" role="alert">@Model.CharactersError <a asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageNumber="@Model.PageNumber" asp-route-pageSize="@Model.PageSize">Réessayer</a></div>
        }
        @if (Model.Characters is { } characters)
        {
            @if (characters.Items.Length == 0)
            {
                <div class="panel empty-state"><h3>Aucun personnage sur cette page</h3><p>Modifiez les filtres ou revenez à la première page.</p><a asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageSize="@Model.PageSize">Première page</a></div>
            }
            else
            {
                <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Personnages du realm @realm.DisplayName</caption><thead><tr><th scope="col">Personnage</th><th scope="col">Compte propriétaire</th><th scope="col">Race / silhouette</th><th scope="col">Présence</th><th scope="col">Création UTC</th></tr></thead><tbody>
                @foreach (var character in characters.Items)
                {
                    <tr><th scope="row">@character.DisplayName<small class="mono">@character.CharacterId</small></th><td><a class="mono" href="@Model.AccountUrl(character.AccountId)">@character.AccountId</a><small>@(Model.AccountsAreCentral ? "Gérer le compte dans l’administration générale ↗" : "Gérer le compte")</small></td><td>@character.Race / @character.Gender</td><td><span class="realm-status @(character.IsOnline ? "ready" : "draft")">@(character.IsOnline ? "En ligne" : "Hors ligne")</span>@if (character.IsOnline && character.LeaseExpiresAt is { } expiresAt) { <small>Bail jusqu’au @expiresAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss") UTC</small> }</td><td>@character.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</td></tr>
                }
                </tbody></table></div>
            }
            <nav class="pagination" aria-label="Pagination des joueurs du realm">
                @if (Model.PageNumber > 1) { <a class="button secondary" asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Précédents</a> }
                <span class="muted">Page @characters.Page</span>
                @if (Model.HasNextCharacters) { <a class="button secondary" asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="players" asp-route-search="@Model.Search" asp-route-onlineOnly="@Model.OnlineOnly" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Suivants</a> }
            </nav>
            <p class="muted">La présence correspond à un bail de jeu actif. Pour déconnecter un personnage ou demander une sauvegarde, utilisez <a asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="game">les actions en jeu de ce realm</a>.</p>
        }
    }
</section>
