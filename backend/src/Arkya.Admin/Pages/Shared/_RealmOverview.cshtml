@model RealmModel
@using Arkya.Admin.Realms
@{ var realm = Model.Realm!; }
<dl class="panel realm-summary">
    <div><dt>Ready servers</dt><dd>@realm.Servers.Sum(server => server.ReadyReplicas)<span> / @realm.Servers.Sum(server => server.DesiredReplicas)</span></dd></div>
    <div><dt>Target</dt><dd class="mono">@realm.TargetId</dd></div>
    <div><dt>Profile</dt><dd class="mono">@realm.ProfileId</dd></div>
    <div><dt>Last change</dt><dd class="realm-summary-date">@realm.UpdatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm 'UTC'")</dd></div>
</dl>
@if (!string.IsNullOrEmpty(realm.ProfileSha256))
{
    <details class="panel realm-advanced"><summary>Deployment profile fingerprint</summary><p class="mono">@realm.ProfileSha256</p><p class="muted">Identifies the frozen configuration to verify before an approved migration.</p></details>
}
@if (realm.Topology is not null || Model.SelectedIsland is not null)
{
    <partial name="_RealmIslands" model="Model" />
    <partial name="_RealmAreaTransitions" model="Model" />
}
<details class="panel realm-advanced" open="@(realm.Topology is null && Model.SelectedIsland is null)"><summary>Dedicated servers <span class="muted">@realm.Servers.Length server(s)</span></summary><div class="realm-server-scroll" tabindex="0" role="region" aria-label="Dedicated server list">
            <ul class="realm-server-list">
            @foreach (var server in realm.Servers)
            {
                <li><div><strong class="mono">@server.Id</strong><small>@(server.Transport == "WebSocket" ? "WebSocket / TCP" : "UDP") @server.Port@if (realm.Topology is not null) { <span> · @RealmPresentation.ServerKindLabel(server.Kind)@if (server.IslandId is not null) { <span> · Area @server.IslandId · partition @(server.PartitionIndex + 1) / @server.PartitionCount</span> }</span> }</small></div><span class="realm-status @(server.ReadyReplicas == server.DesiredReplicas && server.ReadyReplicas > 0 ? "ready" : "pending")">@server.ReadyReplicas / @server.DesiredReplicas ready</span><details class="realm-server-address"><summary>Addresses</summary><code>@(string.IsNullOrWhiteSpace(server.Address) ? "Address pending" : server.Address)</code>@if (server.PublicEndpoint is not null) { <code>@server.PublicEndpoint</code> }</details></li>
            }
            </ul>
</div></details>
<details class="panel realm-advanced"><summary>Deployment details <span class="muted">Revision @realm.Revision · coordinates</span></summary><div class="realm-advanced-body"><dl class="realm-facts"><div><dt>Namespace</dt><dd class="mono">@realm.Namespace</dd></div><div><dt>Server image</dt><dd class="mono">@realm.Image</dd></div></dl><p class="muted">The displayed availability concerns cluster resources. Also verify player admission and entry into the game with an actual client.</p>
@if (realm.Operations?.OrderByDescending(operation => operation.RequestedAt).FirstOrDefault() is { } lastOperation)
{
    <div class="realm-last-operation"><span>Last operation: <strong>@(lastOperation.Kind == "Update" ? "Update" : "Restart")</strong> · @RealmPresentation.StatusLabel(lastOperation.Status)</span><a asp-page="/Realm" asp-route-realmId="@realm.RealmId" asp-route-section="history">View history →</a></div>
}
@if (realm.Topology is not null)
{
    <h3 class="realm-bounds-heading">Partition bounds (X / Z)</h3>
        <div class="table-scroll" tabindex="0" role="region" aria-label="Partition coordinates"><table class="realm-table"><caption class="sr-only">Partition coordinates for each Area and dedicated server</caption><thead><tr><th scope="col">Dedicated server</th><th scope="col">Minimum X / Z</th><th scope="col">Maximum X / Z</th></tr></thead><tbody>
        @foreach (var server in realm.Servers.Where(server => server.Bounds is not null))
        {
            <tr><th scope="row" class="mono">@server.Id</th><td>@server.Bounds!.MinX / @server.Bounds.MinZ</td><td>@server.Bounds.MaxX / @server.Bounds.MaxZ</td></tr>
        }
        </tbody></table></div>
        <p>Partitions are frozen at deployment. Admission and transfers between dedicated servers require a compatible runtime and in-game validation.</p>
    @if (!realm.TopologyRuntimeSupported)
    {
        <p class="realm-topology-note">Deployment is blocked for this profile: support for partitioned Areas is not configured.</p>
    }
}
</div></details>
