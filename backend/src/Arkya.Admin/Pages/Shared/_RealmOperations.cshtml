@model RealmModel
@using Arkya.Admin.Realms
@{ var realm = Model.Realm!; }
<partial name="_RealmConfiguration" model="Model" />
<section class="account-actions" aria-labelledby="operations-heading">
    <div class="section-heading"><h2 id="operations-heading">Actions serveur</h2><span class="muted">Ces actions interrompent les joueurs connectés.</span></div>
    @if (Model.OperationsError is not null) { <div class="alert error" role="alert">@Model.OperationsError</div> }
    @if (Model.OperationsOptions is { } operations)
    {
        <div class="action-grid">
            <form method="post" asp-page="/Realm" asp-page-handler="Restart" asp-route-realmId="@realm.RealmId" class="panel realm-form">
                <h3>Redémarrer le realm</h3><p class="muted">Relancer tous les serveurs dédiés avec l’image actuelle. Prévenez les joueurs avant l’interruption.</p>
                <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" />
                <div class="field"><label for="restart-reason">Motif du redémarrage</label><input id="restart-reason" name="Reason" value="@Model.Reason" maxlength="500" required /></div>
                <div class="field"><label for="restart-confirm">Recopiez @realm.RealmId pour confirmer</label><input id="restart-confirm" name="ConfirmRealmId" value="@Model.ConfirmRealmId" autocomplete="off" required /></div>
                <button class="button danger" type="submit" disabled="@(!operations.CanRestart)">Redémarrer les serveurs</button>
                @if (!operations.CanRestart) { <small>Redémarrage indisponible dans l’état actuel. Actualisez après les opérations en cours.</small> }
            </form>
            <form method="post" asp-page="/Realm" asp-page-handler="Update" asp-route-realmId="@realm.RealmId" class="panel realm-form">
                <h3>Mettre à jour le realm</h3><p class="muted">Installer la version approuvée pour ce realm et relancer ses serveurs.</p>
                @if (operations.UpdateImage is not null) { <dl class="realm-facts"><div><dt>Version approuvée @operations.UpdateVersion</dt><dd class="mono">@operations.UpdateImage</dd></div></dl> }
                else { <p class="muted">Aucune nouvelle version approuvée n’est disponible.</p> }
                <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><input type="hidden" name="ExpectedImage" value="@operations.UpdateImage" />
                <div class="field"><label for="update-reason">Motif de la mise à jour</label><input id="update-reason" name="Reason" value="@Model.Reason" maxlength="500" required /></div>
                <div class="field"><label for="update-confirm">Recopiez @realm.RealmId pour confirmer</label><input id="update-confirm" name="ConfirmRealmId" value="@Model.ConfirmRealmId" autocomplete="off" required /></div>
                <button class="button primary" type="submit" disabled="@(!operations.CanUpdate)">Installer la version approuvée</button>
                @if (!operations.CanUpdate && operations.UpdateImage is not null) { <small>Mise à jour indisponible dans l’état actuel. Actualisez après les opérations en cours.</small> }
            </form>
        </div>
    }
</section>
<section class="account-actions" aria-labelledby="game-heading">
    <div class="section-heading"><h2 id="game-heading">Actions en jeu</h2><span class="muted">La réception et le résultat sont suivis dans l’historique.</span></div>
    @if (Model.CommandsError is not null) { <div class="alert error" role="alert">@Model.CommandsError</div> }
    @if (Model.Commands is { } commands)
    {
        var announceServers = commands.Servers.Where(server => server.Available && server.SupportedCommands.Contains("announce")).ToArray();
        var commandServers = commands.Servers.Where(server => server.Available && server.SupportedCommands.Any(type => type is "kick" or "save")).ToArray();
        var commandTypes = commandServers.SelectMany(server => server.SupportedCommands).Where(type => type is "kick" or "save").Distinct().ToArray();
        @if (!commands.Servers.Any(server => server.Available)) { <div class="workflow-note"><strong>Aucun serveur compatible ne répond</strong><p>Les actions en jeu seront disponibles dès qu’un serveur dédié compatible aura contacté le service. Actualisez pour vérifier sa connexion.</p></div> }
        <div class="panel realm-form"><dl class="detail-grid">
        @foreach (var server in commands.Servers)
        {
            <div><dt>@server.ServerId</dt><dd>@(server.Available ? "Connecté au contrôle en jeu" : "Contrôle en jeu indisponible")<small>Dernier contact : @(server.LastSeenAt?.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss 'UTC'") ?? "jamais")</small></dd></div>
        }
        </dl></div>
        <div class="action-grid">
            <form method="post" asp-page="/Realm" asp-page-handler="Announce" asp-route-realmId="@realm.RealmId" class="panel realm-form">
                <h3>Envoyer un message en jeu</h3><p class="muted">L’annonce est affichée aux joueurs connectés au serveur choisi.</p>
                <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><input type="hidden" name="RequestId" value="@Model.RequestId" />
                <div class="field"><label for="announce-server">Serveur destinataire</label><select id="announce-server" name="ServerId" required>@foreach (var server in announceServers) { <option value="@server.ServerId" selected="@(Model.ServerId == server.ServerId)">@server.ServerId</option> }</select></div>
                <div class="field"><label for="announce-message">Message aux joueurs</label><textarea id="announce-message" name="Message" rows="3" maxlength="400" required aria-describedby="message-limit">@Model.Message</textarea><small id="message-limit">Une ligne, 400 octets UTF-8 maximum. Les accents occupent plusieurs octets.</small></div>
                <div class="field"><label for="announce-reason">Motif de l’annonce</label><input id="announce-reason" name="Reason" value="@Model.Reason" maxlength="500" required /></div>
                <button class="button primary" type="submit" disabled="@(announceServers.Length == 0)">Envoyer l’annonce</button>
            </form>
            <form method="post" asp-page="/Realm" asp-page-handler="Command" asp-route-realmId="@realm.RealmId" class="panel realm-form">
                <h3>Exécuter une commande en jeu</h3><p class="muted">Choisissez une action prise en charge par le serveur dédié.</p>
                <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><input type="hidden" name="RequestId" value="@Model.RequestId" />
                <div class="field"><label for="command-server">Serveur destinataire</label><select id="command-server" name="ServerId" required>@foreach (var server in commandServers) { <option value="@server.ServerId" selected="@(Model.ServerId == server.ServerId)">@server.ServerId — @string.Join(", ", server.SupportedCommands.Where(type => type is "kick" or "save").Select(RealmPresentation.CommandLabel))</option> }</select></div>
                <div class="field"><label for="command-type">Commande</label><select id="command-type" name="CommandType" required>@foreach (var type in commandTypes) { <option value="@type" selected="@(Model.CommandType == type)">@RealmPresentation.CommandLabel(type)</option> }</select></div>
                <div class="field"><label for="command-character">Identifiant du personnage</label><input id="command-character" name="CharacterId" value="@Model.CharacterId" maxlength="36" aria-describedby="character-help" /><small id="character-help">UUID obligatoire pour une déconnexion. Retrouvez-le dans <a asp-page="/Characters" asp-route-onlineOnly="true">les personnages en ligne</a>.</small></div>
                <div class="field"><label for="command-reason">Motif de la commande</label><input id="command-reason" name="Reason" value="@Model.Reason" maxlength="500" required /></div>
                <button class="button secondary" type="submit" disabled="@(commandServers.Length == 0)">Envoyer la commande</button>
            </form>
        </div>
        <section class="history" aria-labelledby="commands-history-heading">
            <div class="section-heading"><h2 id="commands-history-heading">Historique des commandes</h2><span class="muted">50 dernières commandes · UTC</span></div>
            @if (commands.Commands.Length == 0) { <div class="panel history-empty">Aucune commande enregistrée.</div> }
            else
            {
                <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Commandes en jeu et résultats</caption><thead><tr><th scope="col">Commande</th><th scope="col">Serveur</th><th scope="col">État</th><th scope="col">Opérateur / motif</th><th scope="col">Date UTC</th></tr></thead><tbody>
                @foreach (var command in commands.Commands.OrderByDescending(value => value.CreatedAt).Take(50))
                {
                    <tr><th scope="row">@RealmPresentation.CommandLabel(command.Type)@if (!string.IsNullOrEmpty(command.Message)) { <small>@command.Message</small> }@if (!string.IsNullOrEmpty(command.CharacterId)) { <small class="mono">@command.CharacterId</small> }<small class="mono">@command.Id</small></th><td>@command.ServerId</td><td><span class="realm-status @RealmPresentation.CommandStatusClass(command.Status)">@RealmPresentation.CommandStatusLabel(command.Status)</span>@if (command.Status == "Succeeded" && command.AffectedPlayers is { } count) { <small>@count joueur(s) concerné(s)</small> }@if (command.Status == "Failed") { <small>@RealmPresentation.CommandFailureMessage(command.ResultCode)</small> }@if (command.Status == "Unknown") { <small>Le serveur n’a pas confirmé le résultat. Vérifiez en jeu avant de relancer.</small> }</td><td>@command.Actor<small>@command.Reason</small></td><td><time datetime="@command.CreatedAt.ToString("O")">@command.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss")</time>@if (command.CompletedAt is { } completed) { <small>Résultat : @completed.UtcDateTime.ToString("HH:mm:ss")</small> }</td></tr>
                }
                </tbody></table></div>
            }
        </section>
    }
</section>
<section class="history" aria-labelledby="operations-history-heading">
    <div class="section-heading"><h2 id="operations-history-heading">Historique des opérations serveur</h2><span class="muted">100 dernières opérations · UTC</span></div>
    @if (realm.Operations is not { Length: > 0 }) { <div class="panel history-empty">Aucun redémarrage ni mise à jour enregistré.</div> }
    else
    {
        <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Redémarrages et mises à jour du realm</caption><thead><tr><th scope="col">Opération</th><th scope="col">État</th><th scope="col">Opérateur / motif</th><th scope="col">Date UTC</th></tr></thead><tbody>
        @foreach (var operation in realm.Operations.OrderByDescending(value => value.RequestedAt).Take(100))
        {
            <tr><th scope="row">@(operation.Kind == "Update" ? "Mise à jour" : "Redémarrage")<small>Révision @operation.Revision</small></th><td><span class="realm-status @RealmPresentation.StatusClass(operation.Status)">@RealmPresentation.StatusLabel(operation.Status)</span>@if (operation.Status == "Failed") { <small>@RealmPresentation.FailureMessage(operation.Error)</small> }</td><td>@operation.RequestedBy<small>@operation.Reason</small></td><td><time datetime="@operation.RequestedAt.ToString("O")">@operation.RequestedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss")</time>@if (operation.CompletedAt is { } completed) { <small>Fin : @completed.UtcDateTime.ToString("dd/MM/yyyy HH:mm:ss")</small> }</td></tr>
        }
        </tbody></table></div>
    }
</section>
