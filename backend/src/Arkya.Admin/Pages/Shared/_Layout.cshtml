<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Arkya</title>
    <link rel="stylesheet" href="~/admin.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <div class="app-shell">
        <aside class="sidebar" aria-label="Administration Arkya">
            <a class="brand" asp-page="/Index"><span class="brand-mark" aria-hidden="true">A</span><span>ARKYA<small>Atelier de contenu</small></span></a>
            <div class="sidebar-section">UNIVERS</div>
            <a class="nav-item" asp-page="/Index" aria-current="page"><span aria-hidden="true">◇</span> Quêtes</a>
            <div class="sidebar-bottom"><span class="status-dot" aria-hidden="true"></span> Administration du monde
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form method="post" asp-page="/Logout"><button class="logout" type="submit">Se déconnecter</button></form>
                }
            </div>
        </aside>
        <main id="main" class="main-content" tabindex="-1">@RenderBody()</main>
    </div>
</body>
</html>
