@model RealmModel
@using Arkya.Admin.Realms
@{ var realm = Model.Realm!; }
<section class="account-actions" aria-labelledby="operations-heading">
    <div class="section-heading"><h2 id="operations-heading">Server actions</h2><span class="muted">These actions interrupt connected players.</span></div>
    @if (Model.OperationsError is not null) { <div class="alert error" role="alert">@Model.OperationsError</div> }
    @if (Model.OperationsOptions is { } operations)
    {
        <div class="action-grid">
            <details class="panel realm-action-disclosure" name="realm-actions" open="@(Model.ActiveAction == "restart")"><summary><strong>Restart realm</strong><small>Restart servers with the current image.</small></summary>
            <form method="post" asp-page="/Realm" asp-page-handler="Restart" asp-route-realmId="@realm.RealmId" class="realm-form">
                <p class="muted">Restart all dedicated servers with the current image. Notify players before the interruption.</p>
                <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" />
                <div class="field"><label for="restart-reason">Restart reason</label><input id="restart-reason" name="Reason" value="@Model.Reason" maxlength="500" required /></div>
                <div class="field"><label for="restart-confirm">Enter @realm.RealmId to confirm</label><input id="restart-confirm" name="ConfirmRealmId" value="@Model.ConfirmRealmId" autocomplete="off" required /></div>
                <button class="button danger" type="submit" disabled="@(!operations.CanRestart)">Restart servers</button>
                @if (!operations.CanRestart) { <small>Restart is unavailable in the current state. Refresh after current operations finish.</small> }
            </form>
            </details>
            <details class="panel realm-action-disclosure" name="realm-actions" open="@(Model.ActiveAction == "update")"><summary><strong>Update realm</strong><small>Install the approved version.</small></summary>
            <form method="post" asp-page="/Realm" asp-page-handler="Update" asp-route-realmId="@realm.RealmId" class="realm-form">
                <p class="muted">Install the approved version for this realm and restart its servers.</p>
                @if (operations.UpdateImage is not null) { <dl class="realm-facts"><div><dt>Approved version @operations.UpdateVersion</dt><dd class="mono">@operations.UpdateImage</dd></div></dl> }
                else { <p class="muted">No new approved version is available.</p> }
                <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><input type="hidden" name="ExpectedImage" value="@operations.UpdateImage" />
                <div class="field"><label for="update-reason">Update reason</label><input id="update-reason" name="Reason" value="@Model.Reason" maxlength="500" required /></div>
                <div class="field"><label for="update-confirm">Enter @realm.RealmId to confirm</label><input id="update-confirm" name="ConfirmRealmId" value="@Model.ConfirmRealmId" autocomplete="off" required /></div>
                <button class="button primary" type="submit" disabled="@(!operations.CanUpdate)">Install approved version</button>
                @if (!operations.CanUpdate && operations.UpdateImage is not null) { <small>Update is unavailable in the current state. Refresh after current operations finish.</small> }
            </form>
            </details>
        </div>
    }
</section>
<section class="account-actions" aria-labelledby="delete-realm-heading">
    <div class="section-heading"><h2 id="delete-realm-heading">Delete realm</h2><span class="muted">Stop this world and remove its resources.</span></div>
    <details class="panel realm-action-disclosure" name="realm-actions" open="@(Model.ActiveAction == "delete")"><summary><strong>@(realm.Status == "DeleteFailed" ? "Retry realm deletion" : "Delete realm")</strong><small>Remove the world and its dedicated servers.</small></summary>
    <form method="post" asp-page="/Realm" asp-page-handler="Delete" asp-route-realmId="@realm.RealmId" class="realm-form">
        <p>This action interrupts connected players, deletes this realm's resources and removes its public pages. Characters and their saves are retained and remain bound to this realm.</p>
        <input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" />
        <div class="field"><label for="delete-reason">Deletion reason</label><input id="delete-reason" name="Reason" value="@(Model.ActiveAction == "delete" ? Model.Reason : null)" maxlength="500" required /></div>
        <div class="field"><label for="delete-confirm">Enter exactly @realm.RealmId to confirm deletion</label><input id="delete-confirm" name="ConfirmRealmId" value="@(Model.ActiveAction == "delete" ? Model.ConfirmRealmId : null)" autocomplete="off" required /></div>
        <button class="button danger" type="submit" disabled="@(!RealmPresentation.CanDelete(realm))">@(realm.Status == "DeleteFailed" ? "Retry deletion" : "Permanently delete realm")</button>
        @if (!RealmPresentation.CanDelete(realm)) { <small>Deletion is unavailable while an operation is in progress. Refresh to track its progress.</small> }
    </form>
    </details>
</section>
