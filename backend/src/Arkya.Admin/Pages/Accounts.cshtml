@page
@model AccountsModel
@{
    ViewData["Title"] = "Accounts";
}
<header class="page-header"><div><div class="eyebrow">PLAYERS / ACCOUNTS</div><h1>Accounts</h1><p class="intro">Identity, moderation and beta access.</p></div><a class="button secondary" asp-page="/Accounts" asp-route-search="@Model.Search" asp-route-pageNumber="@Model.PageNumber" asp-route-pageSize="@Model.PageSize">Refresh</a></header>
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/Accounts">Try again</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (!Model.Enabled)
{
    <div class="panel empty-state"><h2>Account management is disabled</h2><p>Configure the private Identity connection to view accounts, manage bans and beta access.</p></div>
}
else
{
    <form method="get" class="panel filter-bar"><div class="field"><label asp-for="Search">Search accounts</label><input asp-for="Search" maxlength="100" placeholder="Name, Arkya ID or Discord ID" /></div><div class="field"><label asp-for="PageSize">Results per page</label><select asp-for="PageSize"><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></div><button type="submit" class="button primary">Search</button><a asp-page="/Accounts" class="button secondary">Clear</a></form>
    @if (Model.Accounts is { } accounts)
    {
        <div class="section-heading"><h2>Account directory</h2><span class="muted">@accounts.Total account(s)</span></div>
        @if (accounts.Items.Count == 0) { <div class="panel empty-state"><h3>No accounts on this page</h3><p>Change the search or return to the first page.</p><a asp-page="/Accounts" asp-route-search="@Model.Search">First page</a></div> }
        else
        {
            <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Accounts and permissions</caption><thead><tr><th scope="col">Account</th><th scope="col">Discord</th><th scope="col">Status</th><th scope="col">Beta</th><th scope="col">Created UTC</th></tr></thead><tbody>
            @foreach (var account in accounts.Items)
            {
                <tr><th scope="row"><a asp-page="/Account" asp-route-id="@account.AccountId">@account.DisplayName</a><small class="mono">@account.AccountId</small></th><td class="mono">@account.DiscordUserId</td><td><span class="realm-status @(account.IsBanned ? "failed" : "ready")">@(account.IsBanned ? "Banned" : "Active")</span></td><td><span class="realm-status @(account.HasBetaAccess ? "ready" : "draft")">@(account.HasBetaAccess ? "Granted" : "Not granted")</span></td><td>@account.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</td></tr>
            }
            </tbody></table></div>
        }
        <nav class="pagination" aria-label="Account pagination">@if (Model.PageNumber > 1) { <a class="button secondary" asp-page="/Accounts" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-pageSize="@Model.PageSize">Previous</a> }<span class="muted">Page @accounts.Page</span>@if (Model.HasNext) { <a class="button secondary" asp-page="/Accounts" asp-route-search="@Model.Search" asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-pageSize="@Model.PageSize">Next</a> }</nav>
    }
}
