@page "{id:guid?}"
@model AccountModel
@{
    ViewData["Title"] = Model.Account?.DisplayName ?? "Compte";
}
<header class="page-header"><div><div class="eyebrow">JOUEURS / COMPTES / FICHE</div><h1>@(Model.Account?.DisplayName ?? "Compte")</h1><p class="intro">Accès, modération et personnages du compte.</p></div><a class="button secondary" asp-page="/Accounts">Tous les comptes</a></header>
@if (Model.Notice is not null) { <div class="alert success" role="status">@Model.Notice</div> }
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/Account" asp-route-id="@Model.Id">Recharger la fiche</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (Model.Account is { } account)
{
    <section class="panel" aria-labelledby="identity-heading"><div class="section-heading"><h2 id="identity-heading">Identité du compte</h2><span class="muted">Révision @account.Revision</span></div><dl class="detail-grid"><div><dt>ID Arkya</dt><dd class="mono">@account.AccountId</dd></div><div><dt>ID Discord</dt><dd class="mono">@account.DiscordUserId</dd></div><div><dt>Statut</dt><dd><span class="realm-status @(account.IsBanned ? "failed" : "ready")">@(account.IsBanned ? "Banni" : "Actif")</span></dd></div><div><dt>Accès à la bêta</dt><dd><span class="realm-status @(account.HasBetaAccess ? "ready" : "draft")">@(account.HasBetaAccess ? "Accordé" : "Non accordé")</span></dd></div><div><dt>Création UTC</dt><dd>@account.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Dernière modification UTC</dt><dd>@account.UpdatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</dd></div>@if (account.IsBanned) { <div><dt>Motif du bannissement</dt><dd>@account.BanReason</dd></div> }</dl></section>
    <section class="account-actions" aria-labelledby="actions-heading"><div class="section-heading"><h2 id="actions-heading">Actions opérateur</h2><span class="muted">Un motif est obligatoire pour chaque action.</span></div><div class="action-grid">
        <form method="post" asp-page-handler="@(account.IsBanned ? "Unban" : "Ban")" asp-route-id="@account.AccountId" class="panel realm-form"><h3>@(account.IsBanned ? "Lever le bannissement" : "Bannir le compte")</h3><p class="muted">@(account.IsBanned ? "Le joueur pourra à nouveau se connecter." : "Le compte ne pourra plus se connecter et ses sessions seront révoquées.")</p><input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><div class="field"><label for="moderation-reason">Motif de modération</label><textarea id="moderation-reason" name="Reason" maxlength="500" rows="3" required>@Model.Reason</textarea></div><button class="button @(account.IsBanned ? "secondary" : "danger")" type="submit">@(account.IsBanned ? "Débannir le compte" : "Bannir le compte")</button></form>
        <form method="post" asp-page-handler="Beta" asp-route-id="@account.AccountId" class="panel realm-form"><h3>Accès à la bêta</h3><p class="muted">@(account.HasBetaAccess ? "Retirer l'autorisation d'accès à la bêta." : "Autoriser ce compte à participer à la bêta.")</p><input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><input type="hidden" name="HasBetaAccess" value="@((!account.HasBetaAccess).ToString().ToLowerInvariant())" /><div class="field"><label for="beta-reason">Motif du changement d'accès</label><textarea id="beta-reason" name="Reason" maxlength="500" rows="3" required>@Model.Reason</textarea></div><button class="button @(account.HasBetaAccess ? "secondary" : "primary")" type="submit">@(account.HasBetaAccess ? "Retirer l'accès à la bêta" : "Accorder l'accès à la bêta")</button></form>
    </div></section>
    <section aria-labelledby="characters-heading"><div class="section-heading"><h2 id="characters-heading">Personnages</h2><a asp-page="/Characters" asp-route-accountId="@account.AccountId">Voir tous les personnages de ce compte</a></div>
        @if (!Model.CharactersEnabled) { <div class="panel empty-state"><p>La gestion des personnages est désactivée. Configurez la connexion privée à Characters.</p></div> }
        @if (Model.CharactersError is not null) { <div class="alert error" role="alert">@Model.CharactersError</div> }
        @if (Model.Characters is { } characters)
        {
            @if (characters.Items.Length == 0) { <div class="panel empty-state"><p>Aucun personnage pour ce compte.</p></div> }
            else
            {
                <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Personnages du compte</caption><thead><tr><th scope="col">Personnage</th><th scope="col">Realm</th><th scope="col">Race / silhouette</th><th scope="col">Présence</th></tr></thead><tbody>@foreach (var character in characters.Items) { <tr><th scope="row">@character.DisplayName<small class="mono">@character.CharacterId</small></th><td>@(string.IsNullOrEmpty(character.RealmId) ? "Non lié" : character.RealmId)</td><td>@character.Race / @character.Gender</td><td><span class="realm-status @(character.IsOnline ? "ready" : "draft")">@(character.IsOnline ? "En ligne" : "Hors ligne")</span></td></tr> }</tbody></table></div>
                <p class="muted">@characters.Items.Length sur @characters.Total personnage(s). La présence correspond à un bail de jeu actif.</p>
            }
        }
    </section>
}
