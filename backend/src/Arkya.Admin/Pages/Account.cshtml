@page "{id:guid?}"
@model AccountModel
@{
    ViewData["Title"] = Model.Account?.DisplayName ?? "Account";
}
<header class="page-header"><div><div class="eyebrow">PLAYERS / ACCOUNTS / DETAILS</div><h1>@(Model.Account?.DisplayName ?? "Account")</h1><p class="intro">Account access, moderation and characters.</p></div><a class="button secondary" asp-page="/Accounts">All accounts</a></header>
@if (Model.Notice is not null) { <div class="alert success" role="status">@Model.Notice</div> }
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/Account" asp-route-id="@Model.Id">Reload details</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (Model.Account is { } account)
{
    <section class="panel" aria-labelledby="identity-heading"><div class="section-heading"><h2 id="identity-heading">Account identity</h2><span class="muted">Revision @account.Revision</span></div><dl class="detail-grid"><div><dt>ID Arkya</dt><dd class="mono">@account.AccountId</dd></div><div><dt>ID Discord</dt><dd class="mono">@account.DiscordUserId</dd></div><div><dt>Status</dt><dd><span class="realm-status @(account.IsBanned ? "failed" : "ready")">@(account.IsBanned ? "Banned" : "Active")</span></dd></div><div><dt>Beta access</dt><dd><span class="realm-status @(account.HasBetaAccess ? "ready" : "draft")">@(account.HasBetaAccess ? "Granted" : "Not granted")</span></dd></div><div><dt>Created UTC</dt><dd>@account.CreatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</dd></div><div><dt>Last modified UTC</dt><dd>@account.UpdatedAt.UtcDateTime.ToString("dd/MM/yyyy HH:mm")</dd></div>@if (account.IsBanned) { <div><dt>Ban reason</dt><dd>@account.BanReason</dd></div> }</dl></section>
    <section class="account-actions" aria-labelledby="actions-heading"><div class="section-heading"><h2 id="actions-heading">Operator actions</h2><span class="muted">A reason is required for each action.</span></div><div class="action-grid">
        <form method="post" asp-page-handler="@(account.IsBanned ? "Unban" : "Ban")" asp-route-id="@account.AccountId" class="panel realm-form"><h3>@(account.IsBanned ? "Remove ban" : "Ban account")</h3><p class="muted">@(account.IsBanned ? "The player will be able to sign in again." : "The account will no longer be able to sign in and its sessions will be revoked.")</p><input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><div class="field"><label for="moderation-reason">Moderation reason</label><textarea id="moderation-reason" name="Reason" maxlength="500" rows="3" required>@Model.Reason</textarea></div><button class="button @(account.IsBanned ? "secondary" : "danger")" type="submit">@(account.IsBanned ? "Unban account" : "Ban account")</button></form>
        <form method="post" asp-page-handler="Beta" asp-route-id="@account.AccountId" class="panel realm-form"><h3>Beta access</h3><p class="muted">@(account.HasBetaAccess ? "Remove beta access permission." : "Allow this account to participate in the beta.")</p><input type="hidden" name="ExpectedRevision" value="@Model.ExpectedRevision" /><input type="hidden" name="HasBetaAccess" value="@((!account.HasBetaAccess).ToString().ToLowerInvariant())" /><div class="field"><label for="beta-reason">Reason for access change</label><textarea id="beta-reason" name="Reason" maxlength="500" rows="3" required>@Model.Reason</textarea></div><button class="button @(account.HasBetaAccess ? "secondary" : "primary")" type="submit">@(account.HasBetaAccess ? "Remove beta access" : "Grant beta access")</button></form>
    </div></section>
    <section aria-labelledby="characters-heading"><div class="section-heading"><h2 id="characters-heading">Characters</h2><a asp-page="/Characters" asp-route-accountId="@account.AccountId">View all characters for this account</a></div>
        @if (!Model.CharactersEnabled) { <div class="panel empty-state"><p>Character management is disabled. Configure the private Characters connection.</p></div> }
        @if (Model.CharactersError is not null) { <div class="alert error" role="alert">@Model.CharactersError</div> }
        @if (Model.Characters is { } characters)
        {
            @if (characters.Items.Length == 0) { <div class="panel empty-state"><p>No characters for this account.</p></div> }
            else
            {
                <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Account characters</caption><thead><tr><th scope="col">Character</th><th scope="col">Realm</th><th scope="col">Race / silhouette</th><th scope="col">Presence</th></tr></thead><tbody>@foreach (var character in characters.Items) { <tr><th scope="row">@character.DisplayName<small class="mono">@character.CharacterId</small></th><td>@(string.IsNullOrEmpty(character.RealmId) ? "Unbound" : character.RealmId)</td><td>@character.Race / @character.Gender</td><td><span class="realm-status @(character.IsOnline ? "ready" : "draft")">@(character.IsOnline ? "Online" : "Offline")</span></td></tr> }</tbody></table></div>
                <p class="muted">@characters.Items.Length of @characters.Total character(s). Presence corresponds to an active game lease.</p>
            }
        }
    </section>
}
