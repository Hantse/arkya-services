@page
@model ReportsConnectionModel
@{
    ViewData["Title"] = "Connect Codex";
}
<header class="page-header">
    <div><div class="eyebrow">ASSISTANCE / CODEX</div><h1>Connect Codex</h1><p class="intro">Find player bugs, suggestions and screenshots from Codex.</p></div>
    <a class="button secondary" asp-page="/BugReports">Bugs and suggestions</a>
</header>
@if (!Model.Enabled)
{
    <div class="panel empty-state"><h2>The MCP connection is disabled</h2><p>Enable Reports MCP in the server configuration to connect Codex.</p></div>
}
else
{
    <section class="panel">
        <h2>Local Codex configuration</h2>
        <p>The server <code>@ReportsConnectionModel.McpUrl</code> lets you read reports and their screenshots, then update their statuses and tags.</p>
        <p>The file contains an administrator access key for MCP. Keep it on your computer, outside the repository, and do not share it. Add its section to your local Codex configuration, then reload the MCP connection.</p>
        <form method="post" asp-page-handler="Download"><button type="submit" class="button primary">Download Codex configuration</button></form>
    </section>
}
