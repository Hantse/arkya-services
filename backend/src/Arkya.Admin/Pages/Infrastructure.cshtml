@page "/Infrastructure"
@model InfrastructureModel
@using Arkya.Admin.Realms
@{
    ViewData["Title"] = "Infrastructure k3s";
}
<header class="page-header"><div><div class="eyebrow">INFRASTRUCTURE / K3S</div><h1>Deploy a realm</h1><p class="intro">A profile, a target and all dedicated servers for the world.</p></div><a class="button secondary" asp-page="/Infrastructure">Refresh</a></header>
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error</div> }
@if (!Model.Enabled)
{
    <div class="panel empty-state"><h2>Connect the Realms service</h2><p>Enable RealmsApi with its private address and administrator key to read targets and prepare deployments.</p></div>
}
else if (Model.Loaded)
{
    <div class="infrastructure-banner panel"><div><span class="realm-status @(Model.Options.DeploymentEnabled ? "ready" : "pending")">@(Model.Options.DeploymentEnabled ? "Deployer enabled" : "Deployer disabled")</span><p>@(Model.Options.DeploymentEnabled ? "Requests create workloads in authorised namespaces." : "Realm preparation remains available. Enable the deployer in Realms after configuring the cluster.")</p></div><a class="button primary" asp-page="/RealmCreate">Prepare a realm</a></div>
    <ol class="deployment-steps" aria-label="Deployment workflow">
        <li><strong>Choose the target</strong><span>A pre-authorised k3s namespace reserved for one realm.</span></li>
        <li><strong>Check the profile</strong><span>Linux image pinned by digest, processes and ports.</span></li>
        <li><strong>Create then deploy</strong><span>The realm details page submits the durable request.</span></li>
        <li><strong>Check the servers</strong><span>Track replicas, endpoints and cluster errors.</span></li>
    </ol>
    <section class="dashboard-section" aria-labelledby="targets-heading"><div class="section-heading"><h2 id="targets-heading">Deployment targets</h2><span class="muted">@Model.Options.Targets.Length target(s)</span></div>
    @if (Model.Options.Targets.Length == 0) { <div class="panel empty-state"><h3>No targets configured</h3><p>Add a namespace and its permissions to the Realms service.</p></div> }
    else
    {
        <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Namespaces available for realms</caption><thead><tr><th scope="col">Target</th><th scope="col">Namespace</th><th scope="col">Assignment</th></tr></thead><tbody>
        @foreach (var target in Model.Options.Targets)
        {
            var assigned = Model.Realms.FirstOrDefault(realm => realm.TargetId == target.Id);
            <tr><th scope="row">@target.DisplayName<small class="mono">@target.Id</small></th><td class="mono">@target.Namespace</td><td>@if (assigned is null) { <span class="realm-status ready">Available</span> } else { <a asp-page="/Realm" asp-route-realmId="@assigned.RealmId">@assigned.DisplayName</a> }</td></tr>
        }
        </tbody></table></div>
    }
    </section>
    <section class="dashboard-section" aria-labelledby="profiles-heading"><div class="section-heading"><h2 id="profiles-heading">Realm profiles</h2><span class="muted">@Model.Options.Profiles.Length profile(s)</span></div>
    @if (Model.Options.Profiles.Length == 0) { <div class="panel empty-state"><h3>No profiles configured</h3><p>Publish a Linux dedicated image, then add its digest and realm servers to the Realms configuration.</p></div> }
    @foreach (var profile in Model.Options.Profiles)
    {
        <details class="panel deployment-profile"><summary><strong>@profile.DisplayName</strong><span class="mono">@profile.Id</span><span class="badge">@profile.Servers.Length server(s)</span></summary><div class="profile-body"><label>Immutable image</label><code class="image-digest">@profile.Image</code><ul class="profile-servers">@foreach (var server in profile.Servers) { <li><strong class="mono">@server.Id</strong><span class="mono">@(server.Transport == "WebSocket" ? "WebSocket / TCP" : "UDP") @server.Port</span>@if (server.PublicEndpoint is not null) { <code class="image-digest">@server.PublicEndpoint</code> }</li> }</ul></div></details>
    }
    </section>
    <aside class="workflow-note"><strong>Deployment scope</strong><p>A request deploys all dedicated servers in the profile with their Services. Operations provisions the cluster, namespaces, secrets, TLS/WSS routes and shared Identity, Characters and MongoDB services. The realm details page shows the observed state and allows retries after failure.</p></aside>
}
