@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login-wrap">
    <div class="eyebrow">ARKYA / ADMINISTRATION</div>
    <h1>Administer Arkya</h1>
    <p class="intro">Prepare worlds, deploy servers and publish quests.</p>
    <form method="post" asp-page-handler="@(Model.DiscordEnabled ? "Discord" : null)" class="panel login-panel">
        <input type="hidden" asp-for="ReturnUrl" />
        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
        @if (Model.DiscordEnabled)
        {
            <p>Sign in with the Discord account authorised to administer Arkya.</p>
            <button type="submit" class="button primary">Continue with Discord <span aria-hidden="true">→</span></button>
        }
        else
        {
            <label asp-for="Password">Administrator password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" required maxlength="512" />
            <button type="submit" class="button primary">Sign in <span aria-hidden="true">→</span></button>
        }
    </form>
</div>
