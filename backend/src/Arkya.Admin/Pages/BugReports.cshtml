@page
@model BugReportsModel
@using Arkya.Admin.Reports
@using Arkya.ServiceDefaults.Reports
@{
    ViewData["Title"] = "Bugs and suggestions";
}
<header class="page-header">
    <div><div class="eyebrow">SUPPORT / REPORTS</div><h1>Bugs and suggestions</h1><p class="intro">View player screenshots and track their bugs and ideas.</p></div>
    <a class="button secondary" asp-page="/BugReports" asp-route-tag="@Model.Tag" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-offset="@Model.Offset" asp-route-limit="@Model.Limit">Refresh</a>
</header>
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/BugReports" asp-route-tag="@Model.Tag" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind">Try again</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (!Model.Enabled)
{
    <div class="panel empty-state"><h2>Report management is disabled</h2><p>Enable the Reports service connection in the administration configuration to view bugs and suggestions.</p></div>
}
else
{
    <p><a class="text-link" asp-page="/ReportsConnection">Connect Codex to reports</a></p>
    <form method="get" class="panel report-filters">
        <div class="field"><label asp-for="Kind">Type</label><select asp-for="Kind"><option value="">All types</option>@foreach (var kind in BugReportKinds.All) { <option value="@kind">@BugReportPresentation.KindLabel(kind)</option> }</select></div>
        <div class="field"><label asp-for="Tag">Tag</label><input asp-for="Tag" maxlength="32" placeholder="urgent" /></div>
        <div class="field"><label asp-for="Status">Status</label><select asp-for="Status"><option value="">All statuses</option>@foreach (var status in BugReportStatuses.All) { <option value="@status">@BugReportPresentation.StatusLabel(status, Model.Kind)</option> }</select></div>
        <input type="hidden" asp-for="Limit" />
        <button type="submit" class="button primary">Filter</button><a class="text-link" asp-page="/BugReports">Clear filters</a>
    </form>
    @if (Model.Reports is { } reports)
    {
        <div class="section-heading"><h2>Reports</h2><span class="muted">@reports.Total report(s)</span></div>
        @if (reports.Items.Length == 0)
        {
            <div class="panel empty-state"><h3>No reports on this page</h3><p>New reports will appear here. Adjust the filters or return to the first page.</p><a class="text-link" asp-page="/BugReports" asp-route-tag="@Model.Tag" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind">First page</a></div>
        }
        else
        {
            <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Bugs and suggestions</caption><thead><tr><th scope="col">Report</th><th scope="col">Type</th><th scope="col">Status and tags</th><th scope="col">Received</th></tr></thead><tbody>
            @foreach (var report in reports.Items)
            {
                <tr><th scope="row"><a asp-page="/BugReport" asp-route-id="@report.Id">@report.Title</a><small>@report.Scene · @report.ClientVersion</small></th><td><span class="badge">@BugReportPresentation.KindLabel(report.Kind)</span></td><td><span class="realm-status @BugReportPresentation.StatusClass(report.Status)">@BugReportPresentation.StatusLabel(report.Status, report.Kind)</span><div class="report-tags">@foreach (var tag in report.Tags) { <a class="badge" asp-page="/BugReports" asp-route-tag="@tag" asp-route-kind="@Model.Kind" asp-route-status="@Model.Status">@tag</a> }</div></td><td><time datetime="@report.CreatedAt.ToString("O")">@report.CreatedAt.ToUniversalTime().ToString("dd/MM/yyyy HH:mm 'UTC'")</time></td></tr>
            }
            </tbody></table></div>
        }
        <nav class="report-pagination" aria-label="Report pages">
            @if (Model.HasPrevious) { <a class="button secondary" asp-page="/BugReports" asp-route-tag="@Model.Tag" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-offset="@Math.Max(0, Model.Offset - Model.Limit)" asp-route-limit="@Model.Limit">Previous</a> }
            @if (Model.HasNext) { <a class="button secondary" asp-page="/BugReports" asp-route-tag="@Model.Tag" asp-route-status="@Model.Status" asp-route-kind="@Model.Kind" asp-route-offset="@(Model.Offset + Model.Limit)" asp-route-limit="@Model.Limit">Next</a> }
        </nav>
    }
}
