@page "/Quests"
@model IndexModel
@{
    ViewData["Title"] = "Quests";
}
<header class="page-header">
    <div><div class="eyebrow">WORLD / CONTENT</div><h1>Quests</h1><p class="intro">Write objectives. Publish the next adventures.</p></div>
    <span class="scope-label">ARKYA · WORKSHOP</span>
</header>
@if (Model.Notice is not null) { <div class="alert success" role="status">@Model.Notice</div> }
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/Index">Reload catalogue</a></div> }
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
@if (Model.Loaded)
{
    <div class="workspace">
        <section aria-labelledby="draft-heading">
            <div class="section-heading"><h2 id="draft-heading">Working draft</h2><span class="badge">Revision @Model.Revision</span></div>
            <form method="post" class="quest-form">
                <input type="hidden" asp-for="Revision" />
                @if (Model.Quests.Count == 0)
                {
                    <div class="panel empty-state"><div class="empty-mark" aria-hidden="true">◇</div><h3>Write the first adventure</h3><p>Add a quest and choose how many enemies must be defeated.</p></div>
                }
                @for (var i = 0; i < Model.Quests.Count; i++)
                {
                    <fieldset class="panel quest-editor">
                        <legend class="sr-only">Quest @(i + 1)</legend>
                        <div class="editor-heading"><span class="quest-type">◇ &nbsp; DEFEAT ENEMIES</span><button class="text-button danger" type="submit" asp-page-handler="Remove" name="index" value="@i" formnovalidate>Remove</button></div>
                        <div class="field"><label asp-for="Quests[i].Title">Quest title</label><input asp-for="Quests[i].Title" placeholder="The woodland threat" maxlength="120" required /></div>
                        <div class="field"><label asp-for="Quests[i].QuestId">Permanent ID</label><input asp-for="Quests[i].QuestId" class="mono" placeholder="la-menace-du-bois" pattern="[a-z0-9]+(-[a-z0-9]+)*" maxlength="64" required /><small>Keep this ID for characters who have already accepted this quest.</small></div>
                        <div class="field"><label asp-for="Quests[i].Description">Description</label><textarea asp-for="Quests[i].Description" rows="3" maxlength="2000" placeholder="What awaits the player…"></textarea></div>
                        <div class="objective"><span class="objective-label">OBJECTIVE</span><div class="objective-fields"><span>Defeat</span><label asp-for="Quests[i].RequiredKills" class="sr-only">Number of enemies to defeat</label><input asp-for="Quests[i].RequiredKills" type="number" min="1" max="10000" required /><span>×</span><span class="enemy-name">Prototype monster</span></div></div>
                    </fieldset>
                }
                <div class="editor-actions"><button class="button secondary" type="submit" asp-page-handler="Add" formnovalidate>+ Add a quest</button><button class="button primary" type="submit" asp-page-handler="Save">Save draft</button></div>
            </form>
        </section>
        <aside class="publication-column" aria-labelledby="publish-heading">
            <div class="section-heading"><h2 id="publish-heading">Publication</h2></div>
            <div class="panel publish-panel"><span class="publish-symbol" aria-hidden="true">↗</span><h3>Ready for the world?</h3><p>Publish the saved draft as a version retained in the history.</p><dl class="publication-facts"><div><dt>Saved revision</dt><dd>@Model.Revision</dd></div><div><dt>Applied in game</dt><dd>At next startup</dd></div></dl>
                <form method="post" asp-page-handler="Publish"><input type="hidden" name="Revision" value="@Model.Revision" /><button class="button primary full-width" type="submit" disabled="@(Model.Quests.Count == 0)">Publish this revision <span aria-hidden="true">↗</span></button></form>
                <small>Save your changes before publishing.</small>
            </div>
            <div class="workflow-note"><strong>A version remains stable.</strong><p>Running servers keep their catalogue. Active quests retain their original objective.</p></div>
        </aside>
    </div>
    <section class="history" aria-labelledby="history-heading"><div class="section-heading"><h2 id="history-heading">Published versions</h2><span class="muted">@Model.Catalogs.Length version(s)</span></div>
        @if (Model.Catalogs.Length == 0) { <div class="panel history-empty">Nothing published yet. Save your first quest, then publish it.</div> }
        @foreach (var catalog in Model.Catalogs)
        {
            <details class="panel catalog-entry"><summary><span class="publication-dot" aria-hidden="true"></span><span class="catalog-version mono">@catalog.Version</span><span class="muted">@catalog.Quests.Length quest(s)</span><time datetime="@catalog.PublishedAt.ToString("O")">@catalog.PublishedAt.ToUniversalTime().ToString("dd/MM/yyyy HH:mm 'UTC'")</time><span class="expand-label">Details ↓</span></summary>
                <div class="catalog-detail"><ul>@foreach (var quest in catalog.Quests) { <li><strong>@quest.Title</strong><span>Defeat @quest.RequiredKills enemy/enemies · <code>@quest.QuestId</code></span></li> }</ul><a asp-page-handler="Download" asp-route-version="@catalog.Version" class="text-link">Download JSON catalogue →</a></div>
            </details>
        }
    </section>
}
