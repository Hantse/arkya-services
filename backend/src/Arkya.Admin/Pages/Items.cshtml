@page
@model ItemsModel
@{
    ViewData["Title"] = "Items";
}
<header class="page-header">
    <div><div class="eyebrow">WORLD / CONTENT</div><h1>Items</h1><p class="intro">Create weapons, armour and resources, choose their Unity models, then publish the catalogue.</p></div>
    @if (Model.Enabled) { <a class="button primary" asp-page="/Item">Create an item</a> }
</header>
@if (Model.Notice is not null) { <div class="alert success" role="status">@Model.Notice</div> }
@if (Model.Error is not null) { <div class="alert error" role="alert">@Model.Error <a asp-page="/Items">Reload catalogue</a></div> }
@if (!Model.Enabled) { <div class="panel empty-state"><h2>Item management is disabled</h2><p>Enable the Content service connection to manage the catalogue.</p></div> }
@if (Model.Draft is { } draft)
{
    <div class="item-catalog-layout">
        <section aria-labelledby="draft-heading">
            <div class="section-heading"><h2 id="draft-heading">Draft</h2><span class="badge">Revision @draft.Revision · @draft.Items.Length item(s)</span></div>
            @if (draft.Items.Length == 0) { <div class="panel empty-state"><h3>Create the first item</h3><p>Add a weapon, piece of armour or resource and associate it with a model from the Unity library.</p><a class="button secondary" asp-page="/Item">Create an item</a></div> }
            else
            {
                <div class="panel table-scroll"><table class="realm-table"><caption class="sr-only">Draft items</caption><thead><tr><th scope="col">Item</th><th scope="col">Type</th><th scope="col">Rarity</th><th scope="col">Level</th></tr></thead><tbody>
                @foreach (var item in draft.Items)
                {
                    <tr><th scope="row"><a asp-page="/Item" asp-route-id="@item.ItemId">@item.Name</a><small class="mono">@item.ItemId</small></th><td>@ContentItemPresentation.CategoryLabel(item.Category)</td><td>@ContentItemPresentation.RarityLabel(item.Rarity)</td><td>@item.RequiredLevel</td></tr>
                }
                </tbody></table></div>
            }
        </section>
        <aside aria-labelledby="publish-heading">
            <div class="section-heading"><h2 id="publish-heading">Publication</h2></div>
            <div class="panel publish-panel"><h3>Prepare the next build</h3><p>Publish saved items to freeze their rules and associated models.</p><dl class="publication-facts"><div><dt>Saved revision</dt><dd>@draft.Revision</dd></div><div><dt>Latest version</dt><dd class="mono">@(Model.Catalogs.FirstOrDefault()?.Version ?? "None")</dd></div></dl>
                <form method="post" asp-page-handler="Publish"><input type="hidden" name="Revision" value="@draft.Revision" /><button class="button primary full-width" type="submit" disabled="@(draft.Items.Length == 0)">Publish catalogue</button></form>
                <small>In Unity: Arkya → Items → Content pipeline. Synchronise the published version before starting the build.</small>
            </div>
        </aside>
    </div>
    <section class="history" aria-labelledby="history-heading"><div class="section-heading"><h2 id="history-heading">Published versions</h2><span class="muted">@Model.Catalogs.Length version(s)</span></div>
        @if (Model.Catalogs.Length == 0) { <div class="panel history-empty">No published versions. Create an item, save it, then publish the catalogue.</div> }
        @foreach (var catalog in Model.Catalogs)
        {
            <details class="panel catalog-entry"><summary><span class="publication-dot" aria-hidden="true"></span><span class="catalog-version mono">@catalog.Version</span><span class="muted">@catalog.Items.Length item(s)</span><time datetime="@catalog.PublishedAt.ToString("O")">@catalog.PublishedAt.ToUniversalTime().ToString("dd/MM/yyyy HH:mm 'UTC'")</time><span class="expand-label">Details ↓</span></summary><div class="catalog-detail"><ul>@foreach (var item in catalog.Items) { <li><strong>@item.Name</strong><span>@ContentItemPresentation.CategoryLabel(item.Category) · <code>@item.ItemId</code></span></li> }</ul><a asp-page-handler="Download" asp-route-version="@catalog.Version" class="text-link">Download JSON catalogue →</a></div></details>
        }
    </section>
}
