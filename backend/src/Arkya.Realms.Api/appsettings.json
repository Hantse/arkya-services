{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;arkya-realms;arkya-realms.arkya-operations.svc",
  "Mongo": { "ConnectionString": "mongodb://localhost:27017", "DatabaseName": "arkya_realms" },
  "RealmsAdmin": { "Key": "" },
  "ProxyTrust": { "KnownProxies": [], "KnownNetworks": [], "ForwardLimit": 1 },
  "Deployment": {
    "Enabled": false,
    "ApiServer": "https://kubernetes.default.svc",
    "TokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
    "CertificateAuthorityFile": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
    "ReconcileIntervalSeconds": 10,
    "DeploymentTimeoutSeconds": 300,
    "Targets": [],
    "Profiles": []
  }
}
