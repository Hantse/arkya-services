{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;arkya-inference;arkya-inference.arkya-operations.svc",
  "Mongo": { "ConnectionString": "mongodb://localhost:27017", "DatabaseName": "arkya_inference" },
  "InferenceAdmin": { "Key": "" },
  "Inference": {
    "MaxWorkers": 12,
    "MaxThreadsPerWorker": 24,
    "MaxTotalThreads": 96,
    "HeartbeatSeconds": 5,
    "OfflineAfterSeconds": 30
  },
  "ProxyTrust": { "KnownProxies": [], "KnownNetworks": [], "ForwardLimit": 1 }
}
